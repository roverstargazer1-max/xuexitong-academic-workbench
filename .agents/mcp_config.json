{
  "mcpServers": {
    "xt": {
      "command": "python",
      "args": [
        "-u",
        "./chaoxing-mcp/server.py"
      ],
      "env": {
        "XT_ENV_FILE": "./.env",
        "XT_WORKSPACE_DIR": "./workspace"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
